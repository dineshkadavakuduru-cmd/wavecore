# generated demo audio (regenerate with `npm run gen:tracks`)
# Committed: compressed OGG (~0.7 MB each) for fast clones and deploys
# Excluded: uncompressed WAV (~7 MB each) — regenerate with `npm run gen:tracks` if needed
/public/tracks/*.wav
!/public/tracks/*.ogg

# generated icons (regenerate with `node scripts/generate-icons.mjs`)
